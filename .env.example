# Copy to .env, then configure your own provider. Never commit .env.
SOCIOMEM_PARTICIPATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Alternative: ollama. Configure the model and endpoint you actually run.
# SOCIOMEM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# SOCIOMEM_OLLAMA_MODEL=your-installed-model
# Alternative: anthropic-compatible endpoint.
# SOCIOMEM_ANTHROPIC_BASE_URL=https://your-provider.example
# SOCIOMEM_ANTHROPIC_MODEL=your-model
# SOCIOMEM_ANTHROPIC_API_KEY=
SOCIOMEM_MODEL_FALLBACK=none
SOCIOMEM_PARTICIPATION_SEND=0
SOCIOMEM_STICKER_SEND=0
SOCIOMEM_VOICE_SEND=0
SOCIOMEM_SELFIE_SEND=0
SOCIOMEM_PAT_SEND=0
SOCIOMEM_DIARY_ENABLED=1
SOCIOMEM_MOMENTS_ENABLED=0
SOCIOMEM_MOMENTS_SEND=0
SOCIOMEM_MOMENTS_LIKE_SEND=0
SOCIOMEM_MOMENTS_COMMENT_SEND=0
SOCIOMEM_TRENDS_ENABLED=0
# Vision, generated images, TTS and trend cookies are optional; see docs/configuration.md.
# Network repair is opt-in and may request Windows elevation.
YUXU_ALLOW_NETWORK_REPAIR=0
